[[interaction]]
args = ["api", "rate_limit"]
exit = 0
stdout = '{"resources":{"core":{"limit":5000,"remaining":4990,"reset":2000000000},"graphql":{"limit":5000,"remaining":4990,"reset":2000000000},"search":{"limit":30,"remaining":30,"reset":2000000000}}}'

[[interaction]]
args = ["pr", "view", "no-pr-branch", "--json", "number,title,state,url,isDraft,mergeStateStatus,headRefName,baseRefName,statusCheckRollup"]
exit = 1
stderr = 'no pull requests found for branch "no-pr-branch"'
