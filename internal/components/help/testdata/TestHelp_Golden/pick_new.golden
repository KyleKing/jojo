│                                                                              │
│  ── General ───────────────────────────────────────────────────────────────  │
│         ?  help                                                              │
│         q  close, or quit at the root                                        │
│       esc  back out one level                                                │
│    ctrl+c  cancel the running command, else quit                             │
│                                                                              │
│  ── Move ──────────────────────────────────────────────────────────────────  │
│        gg  top                                                               │
│         G  bottom                                                            │
│    j/down  down a line                                                       │
│      k/up  up a line                                                         │
│    ctrl+d  half a page down                                                  │
│    ctrl+u  half a page up                                                    │
│         @  jump to the working copy                                          │
│                                                                              │
│  ── Flags ─────────────────────────────────────────────────────────────────  │
│        -o  onto (-o)                                                         │
│        -A  insert after (-A)                                                 │
│        -B  insert before (-B)                                                │
│        -n  stay where you are (--no-edit)                                    │
│                                                                              │
│  ── Picking ───────────────────────────────────────────────────────────────  │
│     enter  run it                                                            │
│         p  show the graph before / after the command                         │
│                                                                              │
╰──────────────────────────────────────────────────────────────────────────────╯
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                